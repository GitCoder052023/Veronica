# VERONICA configuration — copy to .env (scripts/setup.sh does this) and edit.

# Inference device: mps (Apple GPU) | cuda | cpu. Empty = auto-detect.
VERONICA_DEVICE=
# Single-view depth model: depth-pro (best, research licence) or
# depth-anything-v2-metric-indoor-small (Apache-2.0, commercial-friendly).
VERONICA_DEPTH_MODEL=depth-pro
# Longest image side used for reconstruction (pixels). Lower = faster, less memory.
VERONICA_MAX_SIDE=1280
# 1 = disable half precision on GPU.
VERONICA_FP32=0
# Where scenes are stored (default: backend/data).
VERONICA_DATA=

# Ports used by scripts/run.sh (native) and docker compose (web).
VERONICA_API_PORT=8787
VERONICA_WEB_PORT=5173
VERONICA_DOCKER_WEB_PORT=8080

# Generative hidden-side completer. On Apple Silicon, run.sh starts a local one
# (Hunyuan3D-2mini on the GPU) when install.sh installed it; set this to 0 to turn it off.
VERONICA_LOCAL_COMPLETER=1
VERONICA_COMPLETER_PORT=8790
# Seconds of inactivity before the local completer frees its ~6 GB of memory.
VERONICA_COMPLETER_IDLE_UNLOAD=300
# Or point at a remote completer (completer-worker with TRELLIS on an NVIDIA machine);
# this takes precedence over the local one.
VERONICA_COMPLETER_URL=
VERONICA_COMPLETER_TOKEN=

# Docker only: torch build for the API image — cpu (default) or a CUDA backend such as cu126.
TORCH_BACKEND=cpu
# Docker only: memory cap for the API container (e.g. 6g). Default: effectively unlimited.
VERONICA_API_MEM_LIMIT=
# Docker only: share the host's model cache instead of a Docker volume, e.g. ~/.cache/huggingface
HF_CACHE=
